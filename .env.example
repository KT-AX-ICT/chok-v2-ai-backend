# FastAPI MySQL (job 진행상태)
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=chok_ai
MYSQL_PASSWORD=password
MYSQL_DB=chok_ai
# docker-compose에서만 사용 (앱은 안 읽음)
MYSQL_ROOT_PASSWORD=root

# Spring 게이트웨이
SPRING_BASE_URL=http://localhost:8080
INTERNAL_SHARED_SECRET=example_shared_secret

# SDK → FastAPI /ingest 인증 키. 콤마 구분 복수 허용(무중단 교체: old,new)
# 비어 있으면 인증 비활성 — 실서버에서는 반드시 설정할 것
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEYS=

# 로그 레벨 (DEBUG/INFO/WARNING/ERROR). 미설정 시 INFO.
# DEBUG 주의: 앱 자체 debug 로그는 2곳 — SQLAlchemy에서 SQL과 파라미터(번들 JSON) 전체 기록. 로컬 단기 진단용으로만 쓸 것. 
# httpx/httpcore는 WARNING 고정(core/logging_config.py)
LOG_LEVEL=INFO

# LLM (OpenAI) — 키가 비어 있으면 LLM 미기동
OPENAI_API_KEY=
OPENAI_MODEL_REPORT=gpt-5.5-2026-04-23
OPENAI_MODEL_ANALYSIS=gpt-5.4-mini-2026-03-17
OPENAI_MODEL_LIGHT=gpt-5.4-nano-2026-03-17
OPENAI_MAX_CONCURRENCY=4
OPENAI_MAX_RETRIES=3
OPENAI_MAX_INPUT_CHARS=120000
