# Python
__pycache__/
*.py[cod]
.venv/

# 환경변수 (로컬 DB 접속 정보 포함 — 커밋 금지)
.env

# 테스트·캐시
.pytest_cache/
.ruff_cache/

# 임시 파일 폴더
tmp/

# 번들 원본(logs/metrics/traces) 파일 저장소 — 로컬 실행 시 생성, 배포는 볼륨 마운트
data/

# 에이전트 작업 산출물 (로컬 워크플로우 아티팩트 — 리포에 넣지 않음)
.playwright-mcp/
docs/superpowers/

# 프롬프트 평가 하네스 실행 생성물 (fixtures/*.json 은 추적, 아래만 무시)
eval/runs/
eval/index.csv
eval/fixtures/*.dup*.json

# baseline 원본 로그(대용량, 일회성 입력) — 생성물 log_profile.json만 커밋
app/services/baseline/_raw/
